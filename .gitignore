# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets never get committed; only the empty template is allowed
.env*
!.env.example

# vercel
.vercel

# Claude Code skill links: these point at .agents/skills on this machine only.
# Recreate them with: npx skills experimental_install -a claude-code
.claude/skills/
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts
